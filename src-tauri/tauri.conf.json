{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IB Study Suite",
  "version": "1.0.1",
  "identifier": "com.ayaanatif.ibstudysuite",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3090",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "IB Study Suite",
        "width": 1440,
        "height": 900,
        "maximized": true,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 1024,
        "minHeight": 700,
        "theme": "Dark",
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
